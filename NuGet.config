<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Jellyfin packages ship on nuget.org. Some machines still have a stale
         "jellyfin" source (repo.jellyfin.org) configured at user level, which now
         returns HTTP 410 Gone; NuGet fails an entire restore when any source
         errors, so clear inherited sources and use nuget.org only. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
